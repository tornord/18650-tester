{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run current file",
      "skipFiles": ["<node_internals>/**"],
      "args": ["--import=tsx/esm", "${file}"],
      "env": {},
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v20.15.1/bin/node",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Test current file",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["${file}", "--run", "--test-timeout=300000", "--reporter=dot"],
      "runtimeArgs": ["--import=tsx/esm"],
      "smartStep": true,
      "env": { "DEBUG": "" },
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v20.15.1/bin/node",
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: brother_ql",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/brother_ql/cli.py",
      "args": [
        "-b",
        "pyusb",
        "-m",
        "QL-700",
        "-p",
        "usb://0x04f9:0x2042",
        "print",
        "-l",
        "29",
        "${workspaceFolder}/output.png"
      ],
      "console": "integratedTerminal",
      "python": "./.venv/bin/python",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: label_api",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/label_api.py",
      "args": [],
      "console": "integratedTerminal",
      "python": "./.venv/bin/python",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
